# ---------------------------------------------------------------------------
# NAGRIK - repository ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Next.js build output
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
.nyc_output/

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Caches
.eslintcache
.cache/
.parcel-cache/

# Editors / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local tooling
.claude/

# Python (for the upcoming FastAPI backend)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Vercel
.vercel
.env
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
*.log
