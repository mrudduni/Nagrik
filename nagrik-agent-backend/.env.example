# LLM Provider Configuration ("gemini" or "openrouter")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=

# Alternative: OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=

# Sarvam AI (Indian Multilingual Speech & Translation)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
ENABLE_SARVAM_FALLBACKS=true

# Memory & Checkpointer ("memory", "redis", or "postgres")
CHECKPOINTER_BACKEND=memory

# Integration flags
USE_MOCK_BACKENDS=true
PERSON1_API_BASE=http://localhost:8001
PERSON3_API_BASE=http://localhost:8002
