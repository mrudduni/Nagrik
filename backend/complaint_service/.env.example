# ==============================================================================
# NAGRIK Complaint Service Environment Configuration
# ==============================================================================

# Database URL
# Option 1 (Default): Zero-setup local SQLite (no Docker or PostgreSQL required)
DATABASE_URL=sqlite+aiosqlite:///complaints.db

# Option 2: Local or Cloud PostgreSQL (Supabase / Render / Neon)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nagrik_complaints

# LLM for AI Classification (Gemini or OpenRouter)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.0-flash-001
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Semantic Vector Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=data/faiss_index.bin

# n8n Webhook Automation
N8N_WEBHOOK_URL=

# SLA Configuration (hours)
DEFAULT_ACK_SLA_HOURS=24
DEFAULT_RESOLUTION_SLA_HOURS=168
SLA_CHECK_INTERVAL_MINUTES=15
DUPLICATE_SIMILARITY_THRESHOLD=0.80
